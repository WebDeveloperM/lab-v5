# base_laboratory/.env  uchun namuna
# Serverda shu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.

# Serverning tashqi manzili — barcha URL'lar shundan hosil bo'ladi
PUBLIC_BASE_URL=https://192.168.101.23

BACKEND_PORT=8030
FRONTEND_PORT=6030
EMPLOYEE_SERVICE_PORT=5000

EMPLOYEE_SERVICE_ENABLED=true
EMPLOYEE_SERVICE_BASE_URL=http://192.168.101.6:5000
EMPLOYEE_SERVICE_PUBLIC_URL=http://192.168.101.6:5000
EMPLOYEE_SERVICE_VERIFY_SSL=false

BNPZID_CLIENT_ID=base-laboratory
# Employee service bilan bir xil bo'lishi shart
BNPZID_CLIENT_SECRET=
